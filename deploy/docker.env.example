# 复制为项目根目录的 .env.docker 后填写。密钥生成：
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"   # YIHU_FIELD_KEY
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                                  # 其余三项
YIHU_ENV=prod
YIHU_SECRET_KEY=
YIHU_FIELD_KEY=
YIHU_INDEX_KEY=
YIHU_DEVICE_API_KEY=
# 比赛演示时打开，正式部署请改为 false
YIHU_DEMO_MODE=true
YIHU_SEED_DEMO=true
