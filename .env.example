# 运行环境：dev / test / prod。prod 下必须显式提供全部密钥
YIHU_ENV=dev
# 演示模式：开启后登录页显示演示账号，提供演示时钟。生产环境务必关闭
YIHU_DEMO_MODE=true
YIHU_HOST=127.0.0.1
YIHU_PORT=8000

# 数据与备份目录。备份目录须与数据目录分离，生产环境建议放在独立磁盘
#YIHU_DATA_DIR=./data
#YIHU_BACKUP_DIR=./backups
#YIHU_DATABASE_URL=sqlite:///./data/yihu.db

# 密钥。执行 python -m app.cli init-env 自动生成，切勿提交到代码仓库
# YIHU_FIELD_KEY 丢失后，已加密的身份证、手机号、地址将无法解密
YIHU_SECRET_KEY=
YIHU_FIELD_KEY=
YIHU_INDEX_KEY=
YIHU_DEVICE_API_KEY=

YIHU_ACCESS_TOKEN_MINUTES=480
YIHU_LOGIN_MAX_FAILURES=5
YIHU_LOGIN_LOCK_MINUTES=15
YIHU_BCRYPT_ROUNDS=12
YIHU_MAX_UPLOAD_MB=10
YIHU_SCHEDULER_ENABLED=true

# 可选：大模型（OpenAI 兼容接口）。留空时预约解析和健康摘要走本地规则
YIHU_LLM_BASE_URL=
YIHU_LLM_API_KEY=
YIHU_LLM_MODEL=
